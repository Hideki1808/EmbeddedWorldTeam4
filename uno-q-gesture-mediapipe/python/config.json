{
  "backend": "mediapipe",
  "camera": {
    "device": "/dev/video0",
    "width": 640,
    "height": 480,
    "fps": 15,
    "mirror": false,
    "timeout_seconds": 5.0
  },
  "recognition": {
    "min_confidence": 0.65,
    "stable_frames": 3,
    "repeat_seconds": 2.0
  },
  "mediapipe": {
    "model_path": "models/gesture_recognizer.task",
    "num_hands": 2,
    "min_hand_detection_confidence": 0.5,
    "min_hand_presence_confidence": 0.5,
    "min_tracking_confidence": 0.5
  },
  "led": {
    "enabled": true,
    "gesture_colors": {
      "Open_Palm": "red",
      "Thumb_Up": "green"
    },
    "heartbeat_seconds": 0.4
  },
  "buzzer": {
    "enabled": true
  }
}
